# When run with two processors, the situation near
# the right boundary of proc 0 is (cut=0.25, no skin)
# atom - 0.1 - boundary - 0.1 - ghost atom - 0.1 - ghost atom - 0.05 - halo boundary - 0.05 - invisible atom
#  0.9            1.0               1.1                1.2                 1.25                    1.3

# Output with 1 proc:
# NEIGH INFO:
# atom at x=0.9 has neighbors at:
#    x=1.1, with neighbors at x=0.9 x=1.2 x=1.3
#
# atom at x=1.1 has neighbors at:
#    x=0.9, with neighbors at x=1.1
#    x=1.2, with neighbors at x=1.1 x=1.3
#    x=1.3, with neighbors at x=1.1 x=1.2
#
# atom at x=1.2 has neighbors at:
#    x=1.1, with neighbors at x=0.9 x=1.2 x=1.3
#    x=1.3, with neighbors at x=1.1 x=1.2
#
# atom at x=1.3 has neighbors at:
#    x=1.1, with neighbors at x=0.9 x=1.2 x=1.3
#    x=1.2, with neighbors at x=1.1 x=1.3

# Output with 2 procs:
# NEIGH INFO:
# atom at x=0.9 has neighbors at:
#    x=1.1, with neighbors at x=0.9 x=1.2


units           metal
dimension       3
boundary        p p p
atom_style      atomic

region          box_region block 0 2 0 1 0 1
create_box      1 box_region

create_atoms    1 single 0.9 0.5 0.5
create_atoms    1 single 1.1 0.5 0.5
create_atoms    1 single 1.2 0.5 0.5
create_atoms    1 single 1.3 0.5 0.5

mass 1 1

pair_style neighprint 0.25
pair_coeff * *

neighbor 0.0 bin

run 0 post no
write_data test.data
